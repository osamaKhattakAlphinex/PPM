# ---------------------------------------------------------------------------
# PPM Platform — environment variables
# Copy to `.env.local` and fill in real values. NEVER commit a filled-in file.
# Every secret lives here only; nothing is hardcoded in source.
# ---------------------------------------------------------------------------

# --- MongoDB ---------------------------------------------------------------
# Required. Standard or SRV connection string. Include credentials here, not in code.
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Required. Database name, kept out of the URI so the same cluster can host
# separate dev / preview / prod databases.
MONGODB_DB_NAME=ppm_platform_dev

# Optional. Connection pool bounds. Keep the pool small on serverless: every
# warm lambda holds its own pool against the cluster's connection limit.
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0

# Optional. Fail fast instead of hanging a request when the primary is unreachable.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
MONGODB_SOCKET_TIMEOUT_MS=45000

# Optional. Let Mongoose build declared indexes on model compile.
# Leave `true` in development; set `false` in production and build indexes
# through a deliberate migration so a deploy can never trigger an index build.
MONGODB_AUTO_INDEX=true

# --- Auth.js ---------------------------------------------------------------
# Required. Signs and encrypts the session cookie. Generate a fresh 32+ byte
# value per environment: `openssl rand -base64 32`. Rotating it signs everyone
# out, which is exactly what you want if it ever leaks.
AUTH_SECRET=

# Optional. Session lifetime in seconds (default 8h — one working shift).
AUTH_SESSION_MAX_AGE=28800

# Optional. How stale a session may be before the next server-side read
# re-checks the user's role, status and tenant against the database (seconds).
# 0 revalidates on every read. Bound on how long a suspended user keeps access.
AUTH_SESSION_REVALIDATE_AFTER=300

# Optional. Set only when the deployment sits behind a proxy that Auth.js
# cannot infer the public origin from (most PaaS hosts do not need it).
# AUTH_URL=https://app.example.com
# AUTH_TRUST_HOST=true

# --- Seed script (local development only) ----------------------------------
# Password given to every user created by `pnpm seed`. Refuses to run against
# NODE_ENV=production. Leave unset to use the script's printed default.
# SEED_PASSWORD=

# --- AI insights (optional) -------------------------------------------------
# The Anthropic API key. SERVER-ONLY: it is read by src/lib/env.ts, which no
# Client Component imports, and it is never exposed on a NEXT_PUBLIC_ variable.
# Leave unset to run the platform without AI Insights — the module then shows a
# "not configured" panel instead of failing.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which model the insight route calls. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# --- Scheduled jobs (optional) ----------------------------------------------
# Shared secret for /api/jobs/* — the notification job that finds overdue
# preventive maintenance and expiring contracts. Sent by the scheduler as
# `Authorization: Bearer <secret>` and compared in constant time.
# Generate with: openssl rand -base64 32
# Leave unset and the job answers 503 rather than running unauthenticated.
# CRON_SECRET=

# --- File storage -----------------------------------------------------------
# Where uploads go when no bucket is configured. Development only: a serverless
# host has no durable disk, and a multi-instance host has a different one per
# instance. Add it to .gitignore if you change it.
UPLOAD_DIR=.uploads

# S3-compatible object storage. Set all three (plus a region) and uploads go to
# the bucket instead of disk — there is no separate flag to forget. Works with
# AWS S3, Cloudflare R2, MinIO and Backblaze B2.
# The bucket must be PRIVATE: files are served only through the authenticated,
# scoped /api/files/[id] route, never by URL.
# S3_BUCKET=
# S3_REGION=me-south-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Public site ------------------------------------------------------------
# The public origin, with no trailing slash. Used for canonical URLs, hreflang
# alternates, Open Graph URLs, the sitemap and robots.txt. NEXT_PUBLIC_ because
# it is the address people type, not a secret — but it must be right per
# environment: a production canonical on a preview build is how a preview
# deployment outranks the real site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Tests (optional) -------------------------------------------------------
# A MongoDB the data-access test suites should use instead of downloading their
# own `mongod` through mongodb-memory-server. Set it in CI, where a service
# container has already started one, or on any network that blocks the download
# host. Each vitest worker takes its own database on it, so the server may be
# shared but the data is not. Never point this at a database you care about —
# the suites wipe every collection between tests.
# MONGO_TEST_URI=mongodb://127.0.0.1:27017
